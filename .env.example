# Web app config for your Firebase project (used by `pnpm build`). Copy to
# .env.production.local and fill in the values from Project settings → Your
# apps → Web app in the Firebase console. In development (`pnpm dev`) the app
# ignores these and talks to the emulators as project demo-is-legal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=
# Set to true to point a production build at the emulators.
VITE_USE_EMULATORS=false
