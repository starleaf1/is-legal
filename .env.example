# Web app config for a real Firebase project (used by `pnpm build`).
# In development (`pnpm dev`) the app ignores these and talks to the
# emulators as project demo-is-legal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=is-legal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=is-legal
VITE_FIREBASE_STORAGE_BUCKET=is-legal.firebasestorage.app
VITE_FIREBASE_APP_ID=
# Set to true to point a production build at the emulators.
VITE_USE_EMULATORS=false
