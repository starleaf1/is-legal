{
  "main": "lib/index.js",
  "scripts": {
    "genkit:start": "GCLOUD_PROJECT=demo-is-legal FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 genkit start -- tsx --watch src/index.ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsx --test src/**/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts",
    "smoke:ask": "tsx scripts/smoke-ask.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "name": "functions",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.42.0",
    "@genkit-ai/google-genai": "^1.42.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "genkit": "^1.42.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "genkit-cli": "^1.44.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true
}
