{
  "name": "is-legal",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Compliance chatbot that answers whether an action is legal and allowed by your organization's policies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starleaf1/is-legal.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "functions:build": "npm --prefix functions run build",
    "functions:watch": "npm --prefix functions run build:watch",
    "emulators": "npm --prefix functions run build && bash scripts/with-java21.sh firebase emulators:start --project demo-is-legal --import .emulator-data --export-on-exit",
    "emulators:fresh": "npm --prefix functions run build && bash scripts/with-java21.sh firebase emulators:start --project demo-is-legal",
    "seed": "npm --prefix functions run seed --",
    "smoke:ask": "npm --prefix functions run smoke:ask",
    "test:rules": "bash scripts/with-java21.sh firebase emulators:exec --only firestore,storage --project demo-is-legal \"vitest run tests/firestore-rules.test.ts tests/storage-rules.test.ts\""
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "dompurify": "^3.2.0",
    "firebase": "^12.0.0",
    "marked": "^15.0.0",
    "roboto-fontface": "*",
    "vue": "^3.5.13",
    "vuetify": "^3.8.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.23.0",
    "eslint-config-vuetify": "^3.0.3",
    "firebase-tools": "^15.33.0",
    "npm-run-all2": "^7.0.2",
    "pinia": "^3.0.1",
    "sass-embedded": "^1.86.3",
    "typescript": "~5.8.2",
    "unplugin-auto-import": "^19.1.1",
    "unplugin-fonts": "^1.3.1",
    "unplugin-vue-components": "^28.4.1",
    "unplugin-vue-router": "^0.12.0",
    "vite": "^6.2.2",
    "vite-plugin-vue-layouts-next": "^0.0.8",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^3",
    "vue-router": "~4.5.0",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs"
    ]
  }
}
